# Non-secret settings only. Copy to .env to override.
DB_PATH=data/cache/rasad.db
SEED=42
OFFLINE_MODE=true
# Weather source for `make data`: auto (cache -> Open-Meteo -> synthetic fallback),
# live (Open-Meteo only, fail if unreachable) or synthetic (never touch the network).
WEATHER_SOURCE=auto
# Demo sign-in (stub roles: lo = Logistics Officer, staff = Staff Officer). Change before showing
# anyone. JWT_SECRET unset means a random secret per API start (tokens die on restart).
DEMO_PASSWORD=demo
# JWT_SECRET=
